# ============================================================
# APPLICATION
# ============================================================

APP_NAME=My FastAPI API
ENVIRONMENT=development

# Generate:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME

# ============================================================
# DATABASE
# ============================================================

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/myapp

# ============================================================
# FRONTEND
# ============================================================

# Comma-separated origins.
#
# Examples:
# http://localhost:3000
# http://localhost:5173
#
# Production:
# https://myfrontend.com
FRONTEND_URLS=http://localhost:3000,http://localhost:5173

# ============================================================
# COOKIE
# ============================================================

COOKIE_NAME=session_id

# Development: false
# Production: true
COOKIE_SECURE=false

# Usually "lax".
#
# If frontend and API are on genuinely different sites and
# cross-site cookies are required, use "none" AND HTTPS.
COOKIE_SAMESITE=lax

# Optional:
COOKIE_DOMAIN=

# Normal session
SESSION_EXPIRE_HOURS=12

# Remember me
REMEMBER_ME_DAYS=30

# ============================================================
# EMAIL
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=My App

# ============================================================
# URL
# ============================================================

# This is the API's public URL.
#
# Example:
# https://api.example.com
#
# Used for email links.
PUBLIC_API_URL=http://localhost:8000

# ============================================================
# AUTH SECURITY
# ============================================================

MAX_LOGIN_FAILURES=5
LOCKOUT_MINUTES=15

IP_RATE_LIMIT_ATTEMPTS=20
IP_RATE_LIMIT_WINDOW_MINUTES=10

EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=30

# ============================================================
# PASSWORD
# ============================================================

MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=128